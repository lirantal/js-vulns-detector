{
  "name": "js-vulns-detector",
  "version": "0.0.0-development",
  "description": "Inject JS to the DOM to find vulnerable JavaScript libraries",
  "bin": {
    "js-vulns-detector": "./bin/cli.cjs"
  },
  "engines": {
    "npm": ">=11.10.0",
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "mkdir dist; node ./bin/cli.cjs --global --outfile dist/bundle-global.js",
    "lint": "eslint src/*",
    "lint:lockfile": "echo \"Lockfile lint skipped for legacy lockfile format\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --config .prettierrc.js --write '**/*.js'",
    "test": "jest",
    "prepare": "npm run build",
    "test:watch": "jest --watch",
    "coverage:view": "open-cli coverage/lcov-report/index.html",
    "lint:markdown": "markdownlint -c .github/.markdownlint.yml -i 'apm_modules/**' -i '.git' -i '__tests__' -i '.github' -i '.changeset' -i 'CODE_OF_CONDUCT.md' -i 'CHANGELOG.md' -i 'docs/**' -i '.superpowers/**' -i 'node_modules' -i 'dist' '**/**.md'",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "author": {
    "name": "Liran Tal",
    "email": "liran.tal@gmail.com",
    "url": "https://github.com/lirantal"
  },
  "license": "Apache-2.0",
  "keywords": [
    "libraries",
    "googlechrome",
    "chrome",
    "security",
    "vulnerabilities",
    "detector",
    "detect"
  ],
  "homepage": "https://github.com/lirantal/js-vulns-detector",
  "bugs": {
    "url": "https://github.com/lirantal/js-vulns-detector/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lirantal/js-vulns-detector.git"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "scripts",
    "vendors"
  ],
  "dependencies": {
    "minimist": "^1.2.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.62.0",
    "js-library-detector": "^6.7.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "babel-eslint": "^10.0.1",
    "babel-jest": "^30.4.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.18.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-standard": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "lockfile-lint": "^5.0.0",
    "open-cli": "^9.0.0",
    "prettier": "^3.9.6",
    "semver": "^7.1.3",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "markdownlint-cli": "0.49.1"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "notify": true,
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "/__tests__/.*/__fixtures__/.*"
    ],
    "coveragePathIgnorePatterns": [
      "main.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts}"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint --env HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged",
      "post-merge": "npm install",
      "pre-push": "npm run lint && npm run test"
    }
  },
  "lint-staged": {
    "**/*.js": [
      "npm run format",
      "git add"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "standard": {
    "env": [
      "jest"
    ],
    "parser": "babel-eslint",
    "ignore": [
      "**/out/"
    ]
  },
  "eslintIgnore": [
    "coverage/**"
  ],
  "eslintConfig": {
    "env": {
      "node": true,
      "es6": true,
      "jest": true
    },
    "plugins": [
      "import",
      "standard",
      "node",
      "security",
      "jest"
    ],
    "extends": [
      "standard",
      "plugin:node/recommended"
    ],
    "rules": {
      "no-process-exit": "warn",
      "jest/no-disabled-tests": "error",
      "jest/no-focused-tests": "error",
      "jest/no-identical-title": "error",
      "node/no-unsupported-features": "off",
      "node/no-unpublished-require": "off",
      "security/detect-non-literal-fs-filename": "error",
      "security/detect-unsafe-regex": "error",
      "security/detect-buffer-noassert": "error",
      "security/detect-child-process": "error",
      "security/detect-disable-mustache-escape": "error",
      "security/detect-eval-with-expression": "error",
      "security/detect-no-csrf-before-method-override": "error",
      "security/detect-non-literal-regexp": "error",
      "security/detect-object-injection": "warn",
      "security/detect-possible-timing-attacks": "error",
      "security/detect-pseudoRandomBytes": "error",
      "space-before-function-paren": "off",
      "object-curly-spacing": "off"
    },
    "parserOptions": {
      "ecmaVersion": 8,
      "ecmaFeatures": {
        "impliedStrict": true
      }
    }
  },
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    "@semantic-release/npm",
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md"
        ]
      }
    ],
    "@semantic-release/github"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
